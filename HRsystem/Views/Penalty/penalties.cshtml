@model HRsystem.ViewModels.EmployeesNPenalties;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "الجزاءات";
}
<h2 class="fs-3 text-center p-4 m-2 text-color3 shadow-lg">إدارة الجزاءات</h2>

<div class="flex flex-col w-full">
    <div class="mx-4">
        <div id="tableResponsive" class="tableContainer">
            @if (Model.Employees.Count == 0)
            {
                <div class="shadow-lg flex justify-center items-center flex-col p-3">
                    <div id="noDataDiv" class="text-center  p-4 m-2 text-[40px]">لا يوجد موظفين</div>
                    <img src="~/images/noEmp2.png" style="width:200px;height:200px" />
                </div>
            }
            else
            {
                <table class="table-base min-w-full border-separate border-spacing-0" id="employeesTable">
                    <thead class="table-dark col-table-header sticky top-0 z-10">
                        <tr>
                            <th>الاسم</th>
                            <th>رقم الهاتف</th>
                            <th>تاريخ التعيين</th>
                            <th>القسم</th>
                            <th>المسمى الوظيفي</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="employeesBody" class="mt-3">
                        @foreach (var employee in Model.Employees)
                        {
                            <tr id="row-@employee.Id" class="snap-start">
                                <td>@employee.Name</td>
                                <td>@employee.PhoneNumber</td>
                                <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                                <td>@employee.Department</td>
                                <td>@employee.JobName</td>
                                <td>
                                    <button class="col-button-dark" onclick="openModal(@employee.Id)">تعديل</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<div id="editModal" class="hidden fixed inset-0 bg-black/30 z-50 items-center justify-center">
    <div id="typePopup" class="col-modal relative p-6 rounded-2xl shadow-xl text-center">
        <button onclick="closeModal()" class="absolute top-2 left-2 text-[25px]">
            <i class="bi bi-x-square-fill"></i>
        </button>

        <!-- Tabs Header -->
        <div class="flex border-b mb-4">
            <button id="tabAdd"
                    class="flex-1 py-2 text-lg font-semibold border-b-2 border-color3 text-color3 hover:text-color3">
                اضافة جزاء
            </button>
            <button id="tabList"
                    class="flex-1 py-2 text-lg font-semibold border-b-2 border-transparent text-color5 hover:text-color3">
                قائمة الجزاءات
            </button>
        </div>

        <!-- Tab Content: Add Penalty -->
        <div id="contentAdd" class="block" dir="rtl">
            <form class="space-y-4" id="addPenaltyForm">
                <input type="hidden" id="employeeId" name="employeeId" value="" />
                <select class="border p-2 w-full rounded focus:outline-none focus:ring focus:ring-[#7B9669]" id="ruleId" name="ruleId">
                    <option value="">اختر نوع الجزاء</option>
                </select>
                <input class="border p-2 w-full rounded focus:outline-none focus:ring focus:ring-[#7B9669]"
                       placeholder="تاريخ الواقعة" type="date" name="incidentDate" />
                <div class="flex gap-2">
                    <select class="border p-2 w-1/2 rounded focus:outline-none focus:ring focus:ring-[#7B9669]" name="deductionUnit" id="deductionUnit">
                        <option value="1">ساعة</option>
                        <option value="2">يوم</option>
                        <option value="3">نسبة مئوية</option>
                        <option value="0">مبلغ مالي</option>
                        <option value="4">إنذار فقط</option>
                    </select>
                    <input class="border p-2 w-1/2 rounded focus:outline-none focus:ring focus:ring-[#7B9669]"
                           type="number" step="0.01" name="deductionValue" id="deductionValue" value="0" />
                </div>
                <textarea class="border p-2 w-full rounded focus:outline-none focus:ring focus:ring-[#7B9669]"
                          placeholder="ملاحظات" name="notes"></textarea>
                <button class="col-button-light px-4 py-2" type="button" onclick="addPenalty()">
                    حفظ
                </button>
            </form>
        </div>

        <!-- Tab Content: Penalties List -->
        <div id="contentList" class="hidden">
            <div id="contentBody" class="overflow-y-auto max-h-64"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Penalty/EditModal.js"></script>
}
