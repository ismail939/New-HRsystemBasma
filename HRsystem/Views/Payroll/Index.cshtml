@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "الرواتب";
}

<div class="max-w-5xl mx-auto p-4">
    <h2 class="fs-3 text-center p-4 m-2 text-color3 shadow-lg rounded-lg">نظام الرواتب</h2>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <!-- Card 1: مكونات الرواتب -->
        <a href="/payroll/salary-components" class="reportCard text-center p-8 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex flex-col items-center justify-center min-h-[180px] group">
            <div class="w-16 h-16 rounded-full bg-color2/20 flex items-center justify-center mb-4 group-hover:bg-color2/30 transition-colors">
                <i class="bi bi-gear-fill text-4xl text-color2"></i>
            </div>
            <span class="text-xl font-bold">مكونات الرواتب</span>
            <span class="text-sm mt-2 opacity-75">إدارة وعرض جميع مكونات الراتب</span>
        </a>

        <!-- Card 2: وضع الرواتب -->
        <a href="/payroll/place-salaries" class="reportCard text-center p-8 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex flex-col items-center justify-center min-h-[180px] group">
            <div class="w-16 h-16 rounded-full bg-color2/20 flex items-center justify-center mb-4 group-hover:bg-color2/30 transition-colors">
                <i class="bi bi-cash-coin text-4xl text-color2"></i>
            </div>
            <span class="text-xl font-bold">وضع الرواتب</span>
            <span class="text-sm mt-2 opacity-75">إدارة رواتب الموظفين وإضافة مكونات الراتب</span>
        </a>

        <!-- Card 3: كشف الرواتب -->
        <a href="/payroll/list" class="reportCard text-center p-8 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 flex flex-col items-center justify-center min-h-[180px] group">
            <div class="w-16 h-16 rounded-full bg-color2/20 flex items-center justify-center mb-4 group-hover:bg-color2/30 transition-colors">
                <i class="bi bi-file-earmark-text-fill text-4xl text-color2"></i>
            </div>
            <span class="text-xl font-bold">كشوفات الرواتب</span>
            <span class="text-sm mt-2 opacity-75">عرض وإنشاء كشوفات الرواتب الشهرية</span>
        </a>
    </div>
</div>