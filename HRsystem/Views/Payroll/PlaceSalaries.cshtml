@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "وضع الرواتب";
}

<h2 class="fs-3 text-center p-4 m-2 text-color3 shadow-lg">وضع الرواتب</h2>

<!-- Filter Section -->
<div class="flex justify-center mb-4">
    <div class="!h-16 bg-[var(--card-bg)] text-[var(--text-primary)] py-1 px-4 rounded-lg w-full md:w-1/2 flex flex-row gap-4 items-center justify-center border border-[var(--card-border)]">
        <div class="flex items-center gap-2">
            <label for="monthPicker" class="text-sm font-medium text-[var(--text-primary)]">اختر الشهر</label>
            <input type="month" id="monthPicker" class="bg-[var(--card-bg)] border-2 border-[var(--color3)] p-1 rounded-lg text-[var(--input-text)]">
        </div>
        <div x-data="{
            showSearch: false,
            toggleSearch() {
                this.showSearch = !this.showSearch;
                if (this.showSearch) {
                    this.$nextTick(() => document.getElementById('searchInput')?.focus());
                } else {
                    const input = document.getElementById('searchInput');
                    if (input) input.value = '';
                    filterEmployees();
                }
            }
        }" class="flex items-center gap-2">
            <button @@click="toggleSearch" class="p-1 col-button-dark transition-all duration-300">
                <i :class="showSearch ? 'bi-arrow-clockwise' : 'bi-search'" class="text-lg"></i>
            </button>
            <template x-if="showSearch">
                <div class="flex items-center gap-2">
                    <input id="searchInput" type="text" placeholder="ابحث عن موظف..." oninput="filterEmployees()"
                           class="border border-[var(--input-border)] rounded-md px-5 py-1 focus:ring focus:ring-[#BAC8B1] focus:outline-none text-sm bg-[var(--input-bg)] text-[var(--input-text)] placeholder-[var(--input-placeholder)]" />
                </div>
            </template>
        </div>
    </div>
</div>

<!-- Employees Table -->
<div id="tableResponsive" class="tableContainer">
    <table class="table-base min-w-full border-separate border-spacing-0" id="employeesTable">
        <thead class="table-dark col-table-header sticky top-0 z-10">
            <tr>
                <th>الاسم الكامل</th>
                <th>رقم الهاتف</th>
                <th>نوع العقد</th>
                <th>التفاصيل</th>
                <th>الراتب</th>
            </tr>
        </thead>
        <tbody id="employeesBody" class="mt-3">
            @foreach (var emp in Model)
            {
                <tr class="snap-start employee-row" data-name="@emp.Name" data-phone="@emp.PhoneNumber" data-contract="@emp.ContractType">
                    <td>@emp.Name</td>
                    <td>@emp.PhoneNumber</td>
                    <td>@emp.ContractType</td>
                    <td>
                        <button class="col-button-dark text-[11px] rounded" onclick="loadEmployeeDetails(@emp.Id)">
                            التفاصيل
                        </button>
                    </td>
                    <td>
                        <button class="col-button-light text-[11px] rounded" onclick="openSalaryModal(@emp.Id, '@emp.Name')">
                            الراتب
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Employee Details Modal -->
<div id="detailsModal" class="hidden fixed inset-0 bg-black/30 z-50 items-center justify-center">
    <div class="col-modal relative p-6 rounded-2xl shadow-xl w-full md:w-1/2 max-h-[90vh] overflow-y-auto">
        <button onclick="closeDetailsModal()" class="absolute top-2 left-2 text-[25px]">
            <i class="bi bi-x-square-fill"></i>
        </button>
        <h3 class="text-lg font-bold mb-4 text-center">تفاصيل الموظف</h3>
        <div id="detailsContent" class="grid grid-cols-1 md:grid-cols-2 gap-3 text-right">
            <!-- Filled dynamically -->
        </div>
    </div>
</div>

<!-- Salary Modal -->
<div id="salaryModal" class="hidden fixed inset-0 bg-black/30 z-50 items-center justify-center">
    <div class="col-modal relative p-6 rounded-2xl shadow-xl w-full md:w-3/4 max-h-[90vh] overflow-y-auto">
        <button onclick="closeSalaryModal()" class="absolute top-2 left-2 text-[25px]">
            <i class="bi bi-x-square-fill"></i>
        </button>
        <h3 id="salaryModalTitle" class="text-lg font-bold mb-3 text-center"></h3>

        <!-- Add new salary component form -->
        <div class="bg-color1 p-3 rounded-lg mb-4 border border-color3">
            <h4 class="font-semibold mb-2">إضافة مكون راتب</h4>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                <input type="hidden" id="salaryEmployeeId" />
                <select id="newComponentId" class="border border-color3 rounded p-2 focus:outline-none focus:ring focus:ring-color3">
                    <option value="">اختر المكون</option>
                </select>
                <input type="number" step="0.01" id="newComponentAmount" placeholder="المبلغ"
                       class="border rounded p-2 focus:outline-none focus:ring focus:ring-[#7B9669]" />
                <input type="text" id="newComponentNotes" placeholder="ملاحظات"
                       class="border rounded p-2 focus:outline-none focus:ring focus:ring-[#7B9669]" />
                <button onclick="addSalaryComponent()" class="col-button-dark px-4 py-2 rounded">إضافة</button>
            </div>
        </div>

        <!-- Current salary components -->
        <div id="salaryComponentsList">
            <table class="table-base min-w-full border-separate border-spacing-0">
                <thead class="col-table-header">
                    <tr>
                        <th>المكون</th>
                        <th>النوع</th>
                        <th>المبلغ</th>
                        <th>الحالة</th>
                        <th>ملاحظات</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody id="salaryComponentsBody">
                </tbody>
            </table>
        </div>

        <!-- Action buttons -->
        <div class="flex justify-center gap-4 mt-4">
            <button onclick="saveEmployeeSalaries()" class="col-button-dark px-6 py-2 rounded text-lg">
                حفظ
            </button>
            <button onclick="generateSalarySlip()" class="col-button-light px-6 py-2 rounded text-lg">
                إنشاء كشف الراتب (السليب)
            </button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteSalaryModal" class="hidden fixed inset-0 bg-black/30 z-50 items-center justify-center">
    <div class="col-modal overflow-hidden relative p-6 rounded-2xl shadow-xl text-center w-full !h-1/4 md:w-1/3">
        <h3 class="text-lg font-bold mb-4">تأكيد الحذف</h3>
        <p class="mb-4" id="deleteSalaryMessage">هل أنت متأكد من حذف هذا المكون؟</p>
        <input type="hidden" id="deleteSalaryId" />
        <div class="flex justify-center gap-4">
            <button onclick="executeDeleteSalary()" class="bg-red-600 text-white px-6 py-2 rounded hover:bg-red-700">حذف</button>
            <button onclick="closeDeleteSalaryModal()" class="col-button-dark px-6 py-2 rounded">إلغاء</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load active components for dropdown
        let activeComponents = [];

        fetch('/payroll/salary-components/active')
            .then(r => r.json())
            .then(data => {
                activeComponents = data;
                console.log('Active components:', activeComponents); // debug to see the structure
                const select = document.getElementById('newComponentId');
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.Id;
                    opt.textContent = `${c.NameAr} (${c.Type === 'Earning' ? 'إضافة' : 'خصم'})`;
                    select.appendChild(opt);
                });
            });

        // Filter employees by search
        function filterEmployees() {
            const query = document.getElementById('searchInput')?.value?.toLowerCase() || '';
            const rows = document.querySelectorAll('.employee-row');
            rows.forEach(row => {
                const name = row.getAttribute('data-name')?.toLowerCase() || '';
                const phone = row.getAttribute('data-phone')?.toLowerCase() || '';
                const contract = row.getAttribute('data-contract')?.toLowerCase() || '';
                if (name.includes(query) || phone.includes(query) || contract.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // ============ DETAILS MODAL ============

        function loadEmployeeDetails(employeeId) {
            document.getElementById('detailsModal').classList.remove('hidden');
            document.getElementById('detailsModal').classList.add('flex');

            fetch(`/payroll/place-salaries/get-employee-detail?employeeId=${employeeId}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) return;
                    const emp = data.data;
                    const content = document.getElementById('detailsContent');
                    // JSON serialization uses PascalCase (PropertyNamingPolicy = null)
                    content.innerHTML = `
                        <div class="p-2 border-b"><span class="font-bold">الاسم:</span> ${emp.Name || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">الرقم القومي:</span> ${emp.NationalId || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">رقم الهاتف:</span> ${emp.PhoneNumber || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">الحالة الاجتماعية:</span> ${emp.MarriageStatus || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">الديانة:</span> ${emp.Religion || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">تاريخ الميلاد:</span> ${emp.DateOfBirth ? new Date(emp.DateOfBirth).toLocaleDateString('ar-EG') : '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">رقم التأمين:</span> ${emp.InsuranceNumber || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">العنوان:</span> ${emp.Address || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">تاريخ التعيين:</span> ${emp.HireDate ? new Date(emp.HireDate).toLocaleDateString('ar-EG') : '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">تاريخ الانتهاء:</span> ${emp.EndDate ? new Date(emp.EndDate).toLocaleDateString('ar-EG') : '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">سبب الانتهاء:</span> ${emp.LeaveReason || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">المسمى الوظيفي:</span> ${emp.JobName || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">نوع العقد:</span> ${emp.ContractType || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">رقم البصمة:</span> ${emp.BasmaId || '-'}</div>
                        <div class="p-2 border-b"><span class="font-bold">القسم:</span> ${emp.DepartmentName || '-'}</div>
                    `;
                });
        }

        function closeDetailsModal() {
            document.getElementById('detailsModal').classList.add('hidden');
            document.getElementById('detailsModal').classList.remove('flex');
        }

        // ============ SALARY MODAL ============

        function openSalaryModal(employeeId, employeeName) {
            loadEmployeeSalaries(employeeId, employeeName);
        }

        function loadEmployeeSalaries(employeeId, employeeName) {
            document.getElementById('salaryEmployeeId').value = employeeId;
            document.getElementById('salaryModal').classList.remove('hidden');
            document.getElementById('salaryModal').classList.add('flex');
            document.getElementById('salaryModalTitle').textContent = `إدارة راتب: ${employeeName}`;

            fetch(`/payroll/salaries/get-employee?employeeId=${employeeId}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) return;

                    const tbody = document.getElementById('salaryComponentsBody');
                    tbody.innerHTML = '';

                    if (data.salaries.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center p-4">لا توجد مكونات راتب لهذا الموظف</td></tr>';
                        return;
                    }

                    console.log('Salaries data:', data.salaries[0]); // debug to see property names
                    data.salaries.forEach(s => {
                        const tr = document.createElement('tr');
                        // Support both PascalCase (PropertyNamingPolicy=null) and camelCase (default)
                        const typeText = (s.ComponentType || s.componentType) === 'Earning' ? 'إضافة' : 'خصم';
                        const typeClass = (s.ComponentType || s.componentType) === 'Earning' ? 'text-green-600' : 'text-red-600';
                        const activeText = (s.IsActive || s.isActive) ? 'نشط' : 'غير نشط';
                        const activeClass = (s.IsActive || s.isActive) ? 'text-green-600' : 'text-red-600';
                        const nameAr = s.ComponentNameAr || s.componentNameAr || '-';
                        const salaryId = s.Id || s.id;
                        const salaryAmount = s.Amount || s.amount;
                        const salaryNotes = s.Notes || s.notes || '';

                        tr.innerHTML = `
                            <td>${nameAr}</td>
                            <td class="${typeClass} font-semibold">${typeText}</td>
                            <td>
                                <input type="number" step="0.01" id="amount-${salaryId}" value="${salaryAmount}"
                                       class="border rounded p-1 w-24 text-center" />
                            </td>
                            <td class="${activeClass} font-semibold">${activeText}</td>
                            <td>
                                <input type="text" id="notes-${salaryId}" value="${salaryNotes}"
                                       class="border rounded p-1 w-32" />
                            </td>
                            <td>
                                <button onclick="editSalary(${salaryId})" class="col-button-dark text-[11px] rounded px-2 py-1">حفظ</button>
                                <button onclick="toggleSalary(${salaryId})" class="col-button-light text-[11px] rounded px-2 py-1 mt-1">
                                    ${(s.IsActive || s.isActive) ? 'تعطيل' : 'تفعيل'}
                                </button>
                                <button onclick="confirmDeleteSalary(${salaryId}, '${nameAr}')" class="bg-red-600 text-white text-[11px] rounded px-2 py-1 mt-1 hover:bg-red-700">
                                    حذف
                                </button>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }

        function closeSalaryModal() {
            document.getElementById('salaryModal').classList.add('hidden');
            document.getElementById('salaryModal').classList.remove('flex');
        }

        function addSalaryComponent() {
            const employeeId = document.getElementById('salaryEmployeeId').value;
            const componentId = document.getElementById('newComponentId').value;
            const amount = document.getElementById('newComponentAmount').value;
            const notes = document.getElementById('newComponentNotes').value;

            if (!componentId || !amount) {
                alert('الرجاء اختيار المكون وإدخال المبلغ');
                return;
            }

            const formData = new FormData();
            formData.append('employeeId', employeeId);
            formData.append('salaryComponentId', componentId);
            formData.append('amount', amount);
            formData.append('notes', notes);

            fetch('/payroll/salaries/add', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('newComponentId').value = '';
                    document.getElementById('newComponentAmount').value = '';
                    document.getElementById('newComponentNotes').value = '';
                    loadEmployeeSalaries(employeeId, document.getElementById('salaryModalTitle').textContent.replace('إدارة راتب: ', ''));
                } else {
                    alert(data.message || 'حدث خطأ');
                }
            });
        }

        function editSalary(id) {
            const amount = document.getElementById(`amount-${id}`).value;
            const notes = document.getElementById(`notes-${id}`).value;
            const employeeId = document.getElementById('salaryEmployeeId').value;

            const formData = new FormData();
            formData.append('id', id);
            formData.append('amount', amount);
            formData.append('notes', notes);

            fetch('/payroll/salaries/edit', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    loadEmployeeSalaries(employeeId, document.getElementById('salaryModalTitle').textContent.replace('إدارة راتب: ', ''));
                } else {
                    alert(data.message || 'حدث خطأ');
                }
            });
        }

        function toggleSalary(id) {
            const employeeId = document.getElementById('salaryEmployeeId').value;
            const formData = new FormData();
            formData.append('id', id);

            fetch('/payroll/salaries/toggle', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    loadEmployeeSalaries(employeeId, document.getElementById('salaryModalTitle').textContent.replace('إدارة راتب: ', ''));
                }
            });
        }

        // ============ DELETE SALARY ============

        function confirmDeleteSalary(id, nameAr) {
            document.getElementById('deleteSalaryId').value = id;
            document.getElementById('deleteSalaryMessage').textContent = `هل أنت متأكد من حذف المكون "${nameAr}"؟`;
            document.getElementById('deleteSalaryModal').classList.remove('hidden');
            document.getElementById('deleteSalaryModal').classList.add('flex');
        }

        function closeDeleteSalaryModal() {
            document.getElementById('deleteSalaryModal').classList.add('hidden');
            document.getElementById('deleteSalaryModal').classList.remove('flex');
        }

        function executeDeleteSalary() {
            const id = document.getElementById('deleteSalaryId').value;
            const employeeId = document.getElementById('salaryEmployeeId').value;

            const formData = new FormData();
            formData.append('id', id);

            fetch('/payroll/salaries/delete', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    closeDeleteSalaryModal();
                    loadEmployeeSalaries(employeeId, document.getElementById('salaryModalTitle').textContent.replace('إدارة راتب: ', ''));
                } else {
                    alert(data.message || 'حدث خطأ');
                }
            });
        }

        function saveEmployeeSalaries() {
            const employeeId = document.getElementById('salaryEmployeeId').value;
            alert('تم حفظ جميع التعديلات بنجاح');
        }

        function generateSalarySlip() {
            const employeeId = document.getElementById('salaryEmployeeId').value;
            const monthPicker = document.getElementById('monthPicker');
            let month, year;
            if (monthPicker && monthPicker.value) {
                const parts = monthPicker.value.split('-');
                year = parts[0];
                month = parts[1];
            } else {
                const now = new Date();
                month = String(now.getMonth() + 1).padStart(2, '0');
                year = now.getFullYear();
            }
            window.open(`/payroll/details/0?employeeId=${employeeId}&month=${month}&year=${year}`, '_blank');
        }
    </script>
}